# Server
PORT=4000
# Required. The server will not start without it (outside NODE_ENV=development/test).
# Use a long random value, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
JWT_SECRET=

# Database (Postgres)
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=tritorc_db
DB_SSL=false

# Outgoing mail (Brevo SMTP). Set these as secrets in AWS App Runner, never commit real values.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Tritorc <response@tritorc.com>
MAIL_REPLY_TO=response@tritorc.com

# Google Sheets mirror for the /m/ mobile landing pages (off unless enabled).
# Set these as secrets in the host's environment, never commit real values.
# Share the spreadsheet with the service account email as Editor.
MOBILE_SHEETS_ENABLED=false
# Preferred: the whole service account key file as one value (inject from AWS Secrets Manager).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative: the two fields separately.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
INDIA_MOBILE_SHEET_ID=INDIA_MOBILE_SHEET_ID
INDIA_MOBILE_SHEET_TAB=India Mobile Leads
GCC_MOBILE_SHEET_ID=GCC_MOBILE_SHEET_ID
GCC_MOBILE_SHEET_TAB=GCC Mobile Leads

# Translate to English (lead drawer) reuses the Google service account above (GOOGLE_SERVICE_ACCOUNT_JSON).
# In its Google Cloud project: enable the Cloud Translation API and grant the account "Cloud Translation API User".
